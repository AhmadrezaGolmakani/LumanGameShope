<div class="luman-nav-header">
    <div class="luman-mobile-brand">
        <span class="luman-mobile-icon">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports"
                     Size="Size.Medium" />
        </span>

        <span class="luman-mobile-title">
            LUMAN <span>GAME SHOP</span>
        </span>
    </div>

    <button title="باز و بسته کردن منو"
            class="navbar-toggler luman-toggler"
            @onclick="ToggleNavMenu">
        <MudIcon Icon="@Icons.Material.Filled.Menu"
                 Size="Size.Medium" />
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable luman-nav-scrollable">
    <nav class="nav flex-column luman-nav">

        <div class="luman-nav-label">
            منوی اصلی
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <MudIcon Icon="@Icons.Material.Outlined.Dashboard"
                         Size="Size.Medium"
                         Class="luman-nav-icon" />
                <span>داشبورد</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="products">
                <MudIcon Icon="@Icons.Material.Outlined.Storefront"
                         Size="Size.Medium"
                         Class="luman-nav-icon" />
                <span>همه محصولات</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="categories">
                <MudIcon Icon="@Icons.Material.Outlined.Category"
                         Size="Size.Medium"
                         Class="luman-nav-icon" />
                <span>دسته‌بندی‌ها</span>
            </NavLink>
        </div>

        <div class="luman-nav-label luman-nav-label-secondary">
            حساب و خرید
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="cart">
                <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart"
                         Size="Size.Medium"
                         Class="luman-nav-icon" />
                <span>سبد خرید</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="orders">
                <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong"
                         Size="Size.Medium"
                         Class="luman-nav-icon" />
                <span>سفارش‌های من</span>
            </NavLink>
        </div>

    </nav>

    <div class="luman-nav-footer">
        <div class="luman-footer-icon">
            <MudIcon Icon="@Icons.Material.Outlined.Bolt"
                     Size="Size.Medium" />
        </div>

        <div class="luman-footer-text">
            <span class="luman-footer-title">LEVEL UP</span>
            <span class="luman-footer-caption">وقت بازیه!</span>
        </div>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
