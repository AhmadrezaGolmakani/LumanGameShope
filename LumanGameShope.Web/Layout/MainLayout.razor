@using LumanGameShope.Web.Services
@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudRTLProvider RightToLeft="true">
<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page luman-layout">

    <aside class="sidebar">
        <div class="luman-brand">
            <div class="luman-brand-icon">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports"
                         Size="Size.Large" />
            </div>

            <div class="luman-brand-text">
                <span class="luman-brand-name">LUMAN</span>
                <span class="luman-brand-subtitle">GAME SHOP</span>
            </div>
        </div>

        <div class="luman-sidebar-content">
            <NavMenu />
        </div>

        <div class="luman-sidebar-footer">
            <MudIcon Icon="@Icons.Material.Outlined.Bolt"
                     Size="Size.Small" />
            <span>LEVEL UP YOUR GAME</span>
        </div>
    </aside>

    <main class="luman-main">

        <header class="top-row luman-topbar">
            <div class="luman-topbar-title">
                <span class="luman-status-dot"></span>
                <span>فروشگاه آنلاین گیمینگ</span>
            </div>

            <div class="luman-topbar-actions">
                <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser"
                         Size="Size.Small"
                         Class="luman-topbar-icon" />

                <span class="luman-trust-text">خرید آسان و سریع</span>

                <div class="luman-account-section">
                    <AuthorizeView Context="authState">
                        <Authorized>
                            <MudMenu Label="@(authState.User.Identity?.Name ?? "کاربر")"
                                     StartIcon="@Icons.Material.Filled.Person"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     Class="luman-account-menu"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">

                                <MudMenuItem Href="/account"
                                             Icon="@Icons.Material.Filled.Person">
                                    حساب کاربری
                                </MudMenuItem>

                                <MudMenuItem Href="/orders"
                                             Icon="@Icons.Material.Filled.ReceiptLong">
                                    سفارش‌های من
                                </MudMenuItem>

                                <MudDivider />

                                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                             OnClick="@LogoutAsync">
                                    خروج از حساب
                                </MudMenuItem>
                            </MudMenu>
                        </Authorized>

                        <NotAuthorized>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Login"
                                       Class="luman-login-button"
                                       Href="/login">
                                ورود / ثبت‌نام
                            </MudButton>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <section class="content luman-content">
            @Body
        </section>

        <footer class="luman-footer">
            <span>© @DateTime.Now.Year Luman Game Shop</span>
            <span>ساخته‌شده برای گیمرها 🎮</span>
        </footer>

    </main>

</div>
</MudRTLProvider>

@code {

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            Secondary = "#22D3EE",
            Background = "#0B1120",
            Surface = "#151E30",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            Divider = "#26364F",
            LinesDefault = "#26364F",
            LinesInputs = "#30415C"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Vazirmatn", "Tahoma", "Arial", "sans-serif" }
            }
        }
    };


    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("lumanLoader.hide");
    }
}