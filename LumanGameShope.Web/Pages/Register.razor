
@page "/register"

@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using LumanGameShope.Web.DTOs.User
@using MudBlazor

@inject HttpClient Http

<PageTitle>ثبت‌نام | لومان</PageTitle>

<div class="register-page" dir="rtl">
    <MudPaper Elevation="0" Class="register-card">

        <div class="register-header">
            <div class="register-logo">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                         Size="Size.Large" />
            </div>

            <MudText Typo="Typo.h5" Class="register-title">
                ایجاد حساب کاربری
            </MudText>

            <MudText Typo="Typo.body2" Class="register-subtitle">
                به لومان بپیوندید و حساب کاربری خود را بسازید.
            </MudText>
        </div>

        <MudDivider Class="register-divider" />

        <MudForm @ref="_form"
                 Model="_model"
                 Validation="@(new Func<object, string, Task<string>>(ValidateProperty))">

            <MudGrid Spacing="3">

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="نام"
                                  Placeholder="نام خود را وارد کنید"
                                  @bind-Value="_model.Name"
                                  For="@(() => _model.Name)"
                                  Required="true"
                                  RequiredError="وارد کردن نام الزامی است."
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="register-field" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="نام خانوادگی"
                                  Placeholder="نام خانوادگی خود را وارد کنید"
                                  @bind-Value="_model.Family"
                                  For="@(() => _model.Family)"
                                  Required="true"
                                  RequiredError="وارد کردن نام خانوادگی الزامی است."
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="register-field" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="نام نمایشی"
                                  Placeholder="نامی که دیگران می‌بینند"
                                  @bind-Value="_model.UserName"
                                  For="@(() => _model.UserName)"
                                  Required="true"
                                  RequiredError="نام نمایشی را وارد کنید."
                                  MaxLength="75"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="register-field" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="ایمیل"
                                  Placeholder="example@email.com"
                                  @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Required="true"
                                  RequiredError="ایمیل را وارد کنید."
                                  Validation="@ValidateEmail"
                                  MaxLength="100"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="register-field" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="کلمه عبور"
                                  Placeholder="کلمه عبور خود را وارد کنید"
                                  @bind-Value="_model.Password"
                                  For="@(() => _model.Password)"
                                  Required="true"
                                  RequiredError="کلمه عبور را وارد کنید."
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="register-field" />
                </MudItem>

            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <MudAlert Severity="_severity"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Class="register-alert">
                    @_message
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="register-submit"
                       Disabled="_isSubmitting"
                       OnClick="RegisterAsync">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="ml-2" />
                    <span>در حال ثبت‌نام...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                             Class="ml-2" />
                    <span>ایجاد حساب کاربری</span>
                }
            </MudButton>

            <div class="register-footer">
                <span>قبلاً حساب کاربری ساخته‌اید؟</span>
                <MudLink Href="/login">وارد شوید</MudLink>
            </div>

        </MudForm>
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private RegisterUserDTOs _model = new();

    private bool _isSubmitting;
    private bool _showPassword;

    private string _message = string.Empty;
    private Severity _severity = Severity.Info;

    private Task<string> ValidateProperty(object model, string propertyName)
    {
        var context = new ValidationContext(model)
        {
            MemberName = propertyName
        };

        var value = model.GetType()
            .GetProperty(propertyName)?
            .GetValue(model);

        var results = new List<ValidationResult>();

        Validator.TryValidateProperty(value, context, results);

        return Task.FromResult(
            results.FirstOrDefault()?.ErrorMessage ?? string.Empty);
    }

    private string ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "ایمیل را وارد کنید.";

        return new EmailAddressAttribute().IsValid(email)
            ? string.Empty
            : "فرمت ایمیل صحیح نیست.";
    }

    private async Task RegisterAsync()
    {
        if (_form is null || _isSubmitting)
            return;

        _message = string.Empty;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        _isSubmitting = true;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "api/v1/Account/Register",
                _model);

            if (response.IsSuccessStatusCode)
            {
                _message = "ثبت‌نام با موفقیت انجام شد. اکنون می‌توانید وارد شوید.";
                _severity = Severity.Success;

                _model = new RegisterUserDTOs();
                await _form.ResetAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _message = "ایمیل یا نام کاربری ممکن است قبلاً ثبت شده باشد؛ اطلاعات را بررسی کنید.";
            }
            else
            {
                _message = $"ثبت‌نام ناموفق بود. کد خطا: {(int)response.StatusCode}";
            }

            _severity = Severity.Error;
        }
        catch (HttpRequestException)
        {
            _message = "ارتباط با سرور برقرار نشد. آدرس API و وضعیت سرور را بررسی کنید.";
            _severity = Severity.Error;
        }
        catch (Exception)
        {
            _message = "خطای غیرمنتظره‌ای رخ داد. لطفاً دوباره تلاش کنید.";
            _severity = Severity.Error;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
