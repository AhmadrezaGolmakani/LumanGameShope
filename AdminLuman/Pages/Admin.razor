@page "/admin"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>پنل مدیریت لومان</PageTitle>

<div class="admin-page" dir="rtl">
    <aside class="admin-sidebar">
        <div class="brand">
            <div class="brand-mark"><MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" /></div>
            <div>
                <div class="brand-title">LUMAN</div>
                <div class="brand-subtitle">پنل مدیریت فروشگاه</div>
            </div>
        </div>

        <div class="sidebar-caption">منوی اصلی</div>
        <MudNavMenu Class="admin-nav">
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">داشبورد</MudNavLink>
            <MudNavLink Href="/admin#products" Icon="@Icons.Material.Filled.Inventory2">مدیریت محصولات</MudNavLink>
            <MudNavLink Href="/admin#categories" Icon="@Icons.Material.Filled.Category">دسته‌بندی‌ها</MudNavLink>
            <MudNavLink Href="/admin#users" Icon="@Icons.Material.Filled.PeopleAlt">مدیریت کاربران</MudNavLink>
        </MudNavMenu>

        <div class="sidebar-bottom">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
            <div>
                <div class="sidebar-bottom-title">دسترسی مدیر</div>
                <div class="sidebar-bottom-subtitle">محیط مدیریت فروشگاه</div>
            </div>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div>
                <div class="eyebrow">مدیریت فروشگاه</div>
                <h1>سلام، خوش اومدی 👋</h1>
                <p>از اینجا می‌تونی محصولات، دسته‌بندی‌ها و کاربران لومان رو مدیریت کنی.</p>
            </div>
            <div class="topbar-actions">
                <MudTooltip Text="بارگذاری مجدد اطلاعات">
                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Default" Size="Size.Large" OnClick="ReloadAllAsync" />
                </MudTooltip>
                <div class="admin-avatar"><MudIcon Icon="@Icons.Material.Filled.Person" /></div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_pageError))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">@_pageError</MudAlert>
        }

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon products-icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></div>
                <div class="stat-label">کل محصولات</div>
                <div class="stat-number">@_products.Count</div>
                <div class="stat-foot">محصول ثبت‌شده در فروشگاه</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon categories-icon"><MudIcon Icon="@Icons.Material.Filled.Category" /></div>
                <div class="stat-label">دسته‌بندی‌ها</div>
                <div class="stat-number">@_categories.Count</div>
                <div class="stat-foot">گروه‌های محصولات</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon users-icon"><MudIcon Icon="@Icons.Material.Filled.PeopleAlt" /></div>
                <div class="stat-label">کاربران این صفحه</div>
                <div class="stat-number">@_users.Count</div>
                <div class="stat-foot">بر اساس نتیجه API کاربران</div>
            </div>
        </section>

        <MudTabs Rounded="true" Elevation="0" ApplyEffectsToContainer="false" PanelClass="admin-tab-panel" Class="admin-tabs">
            <MudTabPanel Text="محصولات" Icon="@Icons.Material.Filled.Inventory2">
                <div id="products" class="section-heading">
                    <div>
                        <h2>مدیریت محصولات</h2>
                        <p>محصولات فروشگاه را مشاهده، اضافه یا حذف کن.</p>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showAddProduct = !_showAddProduct)">افزودن محصول</MudButton>
                </div>

                @if (_showAddProduct)
                {
                    <MudPaper Class="form-panel pa-4 mb-4" Elevation="0">
                        <h3>محصول جدید</h3>
                        <EditForm Model="_newProduct" OnValidSubmit="AddProductAsync">
                            <DataAnnotationsValidator />
                            <div class="form-grid">
                                <MudTextField Label="نام محصول" @bind-Value="_newProduct.Name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="قیمت (تومان)" @bind-Value="_newProduct.Price" Required="true" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudSelect T="string" Label="دسته‌بندی" @bind-Value="_newProduct.CategoryName" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var cat in _categories)
                                    {
                                        <MudSelectItem T="string" Value="@cat.Name">@cat.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <div class="file-field">
                                    <label>تصویر محصول</label>
                                    <InputFile OnChange="OnProductImageSelected" accept=".jpg,.jpeg,.png,.gif,.webp" />
                                    <small>@(_newProduct.Image is null ? "فرمت‌های مجاز: JPG، PNG، GIF، WEBP" : _newProduct.Image.Name)</small>
                                </div>
                            </div>
                            <div class="form-actions">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">ثبت محصول</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => _showAddProduct = false)">انصراف</MudButton>
                            </div>
                        </EditForm>
                    </MudPaper>
                }

                <MudPaper Class="table-panel" Elevation="0">
                    <div class="table-toolbar">
                        <MudTextField @bind-Value="_productSearch" Placeholder="جست‌وجوی نام محصول..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="search-box" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadProductsAsync">بروزرسانی</MudButton>
                    </div>
                    <MudTable Items="@FilteredProducts" Hover="true" Dense="true" Striped="false" Loading="_loadingProducts" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>محصول</MudTh><MudTh>شناسه</MudTh><MudTh>قیمت</MudTh><MudTh>دسته‌بندی</MudTh><MudTh Align="Align.Center">عملیات</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="محصول">
                                <div class="product-cell">
                                    <div class="product-thumb"><MudIcon Icon="@Icons.Material.Filled.Image" /></div>
                                    <div><div class="product-name">@context.Name</div><div class="muted-small">@context.ImageName</div></div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="شناسه">#@context.Id</MudTd>
                            <MudTd DataLabel="قیمت"><span class="price">@context.Price.ToString("N0") تومان</span></MudTd>
                            <MudTd DataLabel="دسته‌بندی">@(string.IsNullOrWhiteSpace(context.CategoryName) ? "—" : context.CategoryName)</MudTd>
                            <MudTd DataLabel="عملیات" Align="Align.Center">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Title="حذف محصول" OnClick="@(() => DeleteProductAsync(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent><div class="empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" /><span>محصولی برای نمایش وجود ندارد.</span></div></NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="دسته‌بندی‌ها" Icon="@Icons.Material.Filled.Category">
                <div id="categories" class="section-heading">
                    <div><h2>مدیریت دسته‌بندی‌ها</h2><p>دسته‌بندی‌های موردنیاز فروشگاه را ایجاد کن.</p></div>
                </div>
                <MudPaper Class="form-panel pa-4 mb-4" Elevation="0">
                    <EditForm Model="_newCategory" OnValidSubmit="AddCategoryAsync">
                        <div class="inline-form">
                            <MudTextField Label="نام دسته‌بندی جدید" @bind-Value="_newCategory.Name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_busy">افزودن دسته‌بندی</MudButton>
                        </div>
                    </EditForm>
                </MudPaper>
                <MudPaper Class="table-panel" Elevation="0">
                    <div class="table-toolbar"><h3>فهرست دسته‌بندی‌ها</h3><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadCategoriesAsync">بروزرسانی</MudButton></div>
                    <MudTable Items="_categories" Hover="true" Dense="true" Loading="_loadingCategories">
                        <HeaderContent><MudTh>نام دسته‌بندی</MudTh><MudTh>شناسه</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd><div class="category-chip"><MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />@context.Name</div></MudTd>
                            <MudTd>@(context.Id?.ToString() ?? "—")</MudTd>
                        </RowTemplate>
                        <NoRecordsContent><div class="empty-state">هنوز دسته‌بندی‌ای ثبت نشده است.</div></NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="کاربران" Icon="@Icons.Material.Filled.PeopleAlt">
                <div id="users" class="section-heading">
                    <div><h2>مدیریت کاربران</h2><p>کاربران را بر اساس ایمیل یا نام کاربری پیدا کن.</p></div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => _showAddUser = !_showAddUser)">افزودن کاربر</MudButton>
                </div>
                @if (_showAddUser)
                {
                    <MudPaper Class="form-panel pa-4 mb-4" Elevation="0">
                        <h3>کاربر جدید</h3>
                        <EditForm Model="_newUser" OnValidSubmit="AddUserAsync">
                            <div class="form-grid">
                                <MudTextField Label="نام" @bind-Value="_newUser.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudTextField Label="نام خانوادگی" @bind-Value="_newUser.Family" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudTextField Label="نام کاربری" @bind-Value="_newUser.UserName" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudTextField Label="ایمیل" @bind-Value="_newUser.Email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudTextField Label="رمز عبور" @bind-Value="_newUser.Password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                            <div class="form-actions">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">ثبت کاربر</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => _showAddUser = false)">انصراف</MudButton>
                            </div>
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">نام فیلدهای DTO ارسالی برای ساخت کاربر باید با CreateUserDTO پروژه API مطابقت داشته باشد.</MudAlert>
                        </EditForm>
                    </MudPaper>
                }

                <MudPaper Class="table-panel" Elevation="0">
                    <div class="user-filters">
                        <MudTextField @bind-Value="_emailFilter" Label="فیلتر ایمیل" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_usernameFilter" Label="فیلتر نام کاربری" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadUsersAsync">جست‌وجو</MudButton>
                    </div>
                    <MudTable Items="_users" Hover="true" Dense="true" Loading="_loadingUsers" Breakpoint="Breakpoint.Sm">
                        <HeaderContent><MudTh>کاربر</MudTh><MudTh>نام کاربری</MudTh><MudTh>ایمیل</MudTh><MudTh>شناسه</MudTh><MudTh Align="Align.Center">عملیات</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd><div class="user-cell"><div class="user-avatar">@Initials(context.Name, context.Family)</div><div><div class="product-name">@($"{context.Name} {context.Family}".Trim())</div><div class="muted-small">کاربر فروشگاه</div></div></div></MudTd>
                            <MudTd>@context.UserName</MudTd><MudTd>@context.Email</MudTd><MudTd>@context.Id</MudTd>
                            <MudTd Align="Align.Center">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Title="ویرایش" OnClick="@(() => StartEditUser(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Title="حذف کاربر" OnClick="@(() => DeleteUserAsync(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent><div class="empty-state">کاربری پیدا نشد.</div></NoRecordsContent>
                    </MudTable>
                    <div class="table-footer">
                        <MudButton Variant="Variant.Text" Disabled="@(_userPage <= 1)" StartIcon="@Icons.Material.Filled.ChevronRight" OnClick="PreviousUsersPageAsync">صفحه قبل</MudButton>
                        <span>صفحه @_userPage</span>
                        <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronLeft" OnClick="NextUsersPageAsync">صفحه بعد</MudButton>
                    </div>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </main>
</div>

@if (_editingUser is not null)
{
    <div class="edit-overlay">
        <MudPaper Class="edit-dialog pa-5" Elevation="12">
            <div class="section-heading"><div><h2>ویرایش کاربر</h2><p>اطلاعات کاربر انتخاب‌شده را اصلاح کن.</p></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editingUser = null)" /></div>
            <EditForm Model="_editingUser" OnValidSubmit="SaveUserEditAsync">
                <div class="form-grid">
                    <MudTextField Label="نام" @bind-Value="_editingUser.Name" Variant="Variant.Outlined" />
                    <MudTextField Label="نام خانوادگی" @bind-Value="_editingUser.Family" Variant="Variant.Outlined" />
                    <MudTextField Label="نام کاربری" @bind-Value="_editingUser.UserName" Required="true" Variant="Variant.Outlined" />
                    <MudTextField Label="ایمیل" @bind-Value="_editingUser.Email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" />
                </div>
                <div class="form-actions"><MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy">ذخیره تغییرات</MudButton><MudButton Variant="Variant.Text" OnClick="@(() => _editingUser = null)">انصراف</MudButton></div>
            </EditForm>
        </MudPaper>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private List<ProductRow> _products = [];
    private List<CategoryRow> _categories = [];
    private List<UserRow> _users = [];
    private ProductForm _newProduct = new();
    private CategoryForm _newCategory = new();
    private UserForm _newUser = new();
    private UserRow? _editingUser;
    private IBrowserFile? _selectedImage;
    private bool _showAddProduct, _showAddUser, _busy;
    private bool _loadingProducts, _loadingCategories, _loadingUsers;
    private string _productSearch = "", _emailFilter = "", _usernameFilter = "", _pageError = "";
    private int _userPage = 1;

    private IEnumerable<ProductRow> FilteredProducts =>
        _products.Where(p => string.IsNullOrWhiteSpace(_productSearch) ||
            (p.Name?.Contains(_productSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await ReloadAllAsync();

    private async Task ReloadAllAsync()
    {
        _pageError = "";
        await LoadCategoriesAsync();
        await LoadProductsAsync();
        await LoadUsersAsync();
    }

    private async Task<HttpRequestMessage> AuthorizedRequestAsync(HttpMethod method, string uri)
    {
        var request = new HttpRequestMessage(method, uri);
        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");
        if (!string.IsNullOrWhiteSpace(token))
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return request;
    }

    private async Task<JsonElement> SendForJsonAsync(HttpMethod method, string uri)
    {
        using var request = await AuthorizedRequestAsync(method, uri);
        using var response = await Http.SendAsync(request);
        var body = await response.Content.ReadAsStringAsync();
        if (!response.IsSuccessStatusCode)
            throw new Exception($"خطای API ({(int)response.StatusCode}): {FriendlyError(body)}");
        if (string.IsNullOrWhiteSpace(body)) return JsonDocument.Parse("{}").RootElement.Clone();
        using var doc = JsonDocument.Parse(body);
        return doc.RootElement.Clone();
    }

    private async Task SendAsync(HttpRequestMessage request)
    {
        using (request)
        using (var response = await Http.SendAsync(request))
        {
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
                throw new Exception($"خطای API ({(int)response.StatusCode}): {FriendlyError(body)}");
        }
    }

    private static string FriendlyError(string body) =>
        string.IsNullOrWhiteSpace(body) ? "پاسخی از سرور دریافت نشد." : body.Length > 350 ? body[..350] : body;

    private async Task LoadProductsAsync()
    {
        _loadingProducts = true;
        try
        {
            var json = await SendForJsonAsync(HttpMethod.Get, "api/v2/Admin/GetAllProduct");
            _products = UnwrapArray(json).Select(ProductRow.FromJson).Where(x => x is not null).Cast<ProductRow>().ToList();
        }
        catch (Exception ex) { _pageError = ex.Message; Snackbar.Add("دریافت محصولات ناموفق بود.", Severity.Error); }
        finally { _loadingProducts = false; }
    }

    private async Task LoadCategoriesAsync()
    {
        _loadingCategories = true;
        try
        {
            var json = await SendForJsonAsync(HttpMethod.Get, "api/v2/Admin/GetAllCategory");
            _categories = UnwrapArray(json).Select(CategoryRow.FromJson).Where(x => x is not null).Cast<CategoryRow>().ToList();
        }
        catch (Exception ex) { _pageError = ex.Message; Snackbar.Add("دریافت دسته‌بندی‌ها ناموفق بود.", Severity.Error); }
        finally { _loadingCategories = false; }
    }

    private async Task LoadUsersAsync()
    {
        _loadingUsers = true;
        try
        {
            var url = $"api/v2/Admin/GetUser?pageid={_userPage}&fillterEmail={Uri.EscapeDataString(_emailFilter)}&fillterUsername={Uri.EscapeDataString(_usernameFilter)}";
            var json = await SendForJsonAsync(HttpMethod.Get, url);
            _users = UnwrapArray(json).Select(UserRow.FromJson).Where(x => x is not null).Cast<UserRow>().ToList();
        }
        catch (Exception ex) { _pageError = ex.Message; Snackbar.Add("دریافت کاربران ناموفق بود.", Severity.Error); }
        finally { _loadingUsers = false; }
    }

    private static IEnumerable<JsonElement> UnwrapArray(JsonElement root)
    {
        if (root.ValueKind == JsonValueKind.Array) return root.EnumerateArray().Select(x => x.Clone()).ToList();
        if (root.ValueKind == JsonValueKind.Object)
        {
            foreach (var key in new[] { "data", "items", "result", "products", "users", "categories" })
            {
                if (TryGet(root, key, out var value) && value.ValueKind == JsonValueKind.Array)
                    return value.EnumerateArray().Select(x => x.Clone()).ToList();
            }
        }
        return [];
    }

    private static bool TryGet(JsonElement element, string name, out JsonElement value)
    {
        foreach (var prop in element.EnumerateObject())
            if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase)) { value = prop.Value; return true; }
        value = default; return false;
    }

    private async Task AddCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCategory.Name)) return;
        _busy = true;
        try
        {
            var request = await AuthorizedRequestAsync(HttpMethod.Post, "api/v2/Admin/AddCategories");
            request.Content = JsonContent.Create(new { Name = _newCategory.Name.Trim() });
            await SendAsync(request);
            Snackbar.Add("دسته‌بندی اضافه شد.", Severity.Success);
            _newCategory = new(); await LoadCategoriesAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private void OnProductImageSelected(InputFileChangeEventArgs e) => _selectedImage = e.File;

    private async Task AddProductAsync()
    {
        if (_selectedImage is null) { Snackbar.Add("لطفاً تصویر محصول را انتخاب کن.", Severity.Warning); return; }
        _busy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_newProduct.Name ?? ""), "Name");
            content.Add(new StringContent(_newProduct.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)), "Price");
            content.Add(new StringContent(_newProduct.CategoryName ?? ""), "Categoryname");
            var stream = _selectedImage.OpenReadStream(8 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_selectedImage.ContentType);
            content.Add(fileContent, "Imagename", _selectedImage.Name);
            var request = await AuthorizedRequestAsync(HttpMethod.Post, "api/v2/Admin/AddProduct");
            request.Content = content;
            await SendAsync(request);
            Snackbar.Add("محصول با موفقیت ثبت شد.", Severity.Success);
            _newProduct = new(); _selectedImage = null; _showAddProduct = false;
            await LoadProductsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeleteProductAsync(ProductRow product)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync("حذف محصول", $"محصول «{product.Name}» حذف شود؟", yesText: "حذف", cancelText: "انصراف");
        if (confirm != true) return;
        try
        {
            var request = await AuthorizedRequestAsync(HttpMethod.Delete, $"api/v2/Admin/DeleteProduct/{product.Id}");
            await SendAsync(request);
            Snackbar.Add("محصول حذف شد.", Severity.Success); await LoadProductsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AddUserAsync()
    {
        _busy = true;
        try
        {
            var request = await AuthorizedRequestAsync(HttpMethod.Post, "api/v2/Admin/AddUser");
            request.Content = JsonContent.Create(new { Name = _newUser.Name, Family = _newUser.Family, UserName = _newUser.UserName, Email = _newUser.Email, Password = _newUser.Password });
            await SendAsync(request);
            Snackbar.Add("درخواست ثبت کاربر ارسال شد.", Severity.Success);
            _newUser = new(); _showAddUser = false; await LoadUsersAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private void StartEditUser(UserRow user) => _editingUser = new UserRow { Id = user.Id, Name = user.Name, Family = user.Family, Email = user.Email, UserName = user.UserName };

    private async Task SaveUserEditAsync()
    {
        if (_editingUser is null) return;
        _busy = true;
        try
        {
            var request = await AuthorizedRequestAsync(HttpMethod.Patch, $"api/v2/Admin/Editeuser/{_editingUser.Id}");
            request.Content = JsonContent.Create(new { UserId = _editingUser.Id, Name = _editingUser.Name, Family = _editingUser.Family, Email = _editingUser.Email, UserName = _editingUser.UserName });
            await SendAsync(request);
            Snackbar.Add("اطلاعات کاربر بروزرسانی شد.", Severity.Success); _editingUser = null; await LoadUsersAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeleteUserAsync(UserRow user)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync("حذف کاربر", $"کاربر «{user.UserName}» حذف شود؟", yesText: "حذف", cancelText: "انصراف");
        if (confirm != true) return;
        try
        {
            var request = await AuthorizedRequestAsync(HttpMethod.Delete, $"api/v2/Admin/DeleteUser/{user.Id}");
            await SendAsync(request);
            Snackbar.Add("کاربر حذف شد.", Severity.Success); await LoadUsersAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;
    private Task PreviousUsersPageAsync() { if (_userPage > 1) _userPage--; return LoadUsersAsync(); }
    private Task NextUsersPageAsync() { _userPage++; return LoadUsersAsync(); }
    private static string Initials(string? name, string? family) => $"{(string.IsNullOrWhiteSpace(name) ? "" : name[..1])}{(string.IsNullOrWhiteSpace(family) ? "" : family[..1])}";

    private sealed class ProductForm { public string? Name { get; set; } public decimal Price { get; set; } public string? CategoryName { get; set; } public IBrowserFile? Image { get; set; } }
    private sealed class CategoryForm { public string? Name { get; set; } }
    private sealed class UserForm { public string? Name { get; set; } public string? Family { get; set; } public string? UserName { get; set; } public string? Email { get; set; } public string? Password { get; set; } }

    private sealed class ProductRow
    {
        public int Id { get; set; } public string? Name { get; set; } public decimal Price { get; set; } public string? ImageName { get; set; } public string? CategoryName { get; set; }
        public static ProductRow? FromJson(JsonElement e)
        {
            if (e.ValueKind != JsonValueKind.Object) return null;
            return new ProductRow { Id = Int(e, "ProductId", "Id", "productId"), Name = Str(e, "Name", "name"), Price = Dec(e, "Price", "price"), ImageName = Str(e, "imagename", "ImageName", "imageName"), CategoryName = Str(e, "CategoryName", "categoryName", "Category") };
        }
    }
    private sealed class CategoryRow
    {
        public int? Id { get; set; } public string Name { get; set; } = "";
        public static CategoryRow? FromJson(JsonElement e) => e.ValueKind != JsonValueKind.Object ? null : new CategoryRow { Id = Has(e, "CategoryId", "Id", "GroupId") ? Int(e, "CategoryId", "Id", "GroupId") : null, Name = Str(e, "Name", "name") ?? "" };
    }
    private sealed class UserRow
    {
        public int Id { get; set; } public string? Name { get; set; } public string? Family { get; set; } public string? Email { get; set; } public string? UserName { get; set; }
        public static UserRow? FromJson(JsonElement e) => e.ValueKind != JsonValueKind.Object ? null : new UserRow { Id = Int(e, "UserId", "Id", "userId"), Name = Str(e, "Name", "name"), Family = Str(e, "Family", "family"), Email = Str(e, "Email", "email"), UserName = Str(e, "UserName", "username", "userName") };
    }
    private static bool Has(JsonElement e, params string[] keys) => keys.Any(k => TryGet(e, k, out _));
    private static string? Str(JsonElement e, params string[] keys) { foreach (var k in keys) if (TryGet(e, k, out var v)) return v.ValueKind == JsonValueKind.String ? v.GetString() : v.ToString(); return null; }
    private static int Int(JsonElement e, params string[] keys) { foreach (var k in keys) if (TryGet(e, k, out var v) && int.TryParse(v.ToString(), out var n)) return n; return 0; }
    private static decimal Dec(JsonElement e, params string[] keys) { foreach (var k in keys) if (TryGet(e, k, out var v) && decimal.TryParse(v.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)) return n; return 0; }
}
